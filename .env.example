# Intern API adresi. Değiştirince Next.js'i yeniden başlatın; yayında yeniden build alın.
NEXT_PUBLIC_API_URL=http://localhost:5100

# Vercel'de NEXT_PUBLIC_API_URL değişkenini eklemeyin (veya boş bırakın).
# Yayında API istekleri aynı sitenin /api yolu üzerinden Render'a iletilir.
# Bu projenin Render adresi varsayılan olarak tanımlıdır. Farklı backend için:
# INTERNAL_API_URL=https://backend-adiniz.onrender.com
