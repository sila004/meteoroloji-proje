<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6537497">
  <PropertyGroup>
    <StartupCommand>npm run dev -- --port 3000</StartupCommand>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BuildCommand>npm run build</BuildCommand>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\.next</BuildOutputFolder>
    <DefaultItemExcludes>$(DefaultItemExcludes);.next\**;.git\**;.vercel\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
